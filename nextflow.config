// gel-sig-workflow: tumour/normal WGS copy number pipeline.
// Example: nextflow run main.nf -profile slurm,singularity
// Reference paths per genome build are in conf/genomes.config.

manifest {
    name            = 'gel-sig-workflow/cn-pipeline'
    author          = 'Philip Smith'
    homePage        = 'https://github.com/Phil9S/gel-sig-workflow'
    description     = 'Tumour/normal WGS copy number: Battenberg, SNV VAF evaluation, downsampled sWGS absolute CN and ASCAT at SNP6 loci'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
    version         = '0.1.0'
}

params {
    // Input/output
    samples                 = "${projectDir}/config/samples.tsv"
    outdir                  = 'results/cn_pipeline'
    publish_dir_mode        = 'copy' // copy | symlink | link | rellink | copyNoFollow | move

    // Pipeline steps
    skip_vaf_evaluation     = false
    skip_swgs               = false
    skip_ascat              = false
    call_snvs               = true // Strelka2 for samples with no snv_vcf
    ignore_failed_samples   = true // drop failed samples instead of stopping the run

    // Battenberg (defaults match battenberg_wgs.R v3.0.0)
    battenberg_min_ploidy                   = 1.6
    battenberg_max_ploidy                   = 4.8
    battenberg_min_rho                      = 0.1
    battenberg_max_rho                      = 1.02
    battenberg_min_goodness                 = 0.63
    battenberg_platform_gamma               = 1
    battenberg_phasing_gamma                = 1
    battenberg_segmentation_gamma           = 20
    battenberg_segmentation_kmin            = 3
    battenberg_phasing_kmin                 = 1
    battenberg_clonality_dist_metric        = 0
    battenberg_ascat_dist_metric            = 1
    battenberg_uninformative_baf_threshold  = 0.51
    battenberg_min_normal_depth             = 10
    battenberg_min_base_qual                = 20
    battenberg_min_map_qual                 = 35
    battenberg_calc_seg_baf_option          = 3
    battenberg_max_allowed_state            = 250
    battenberg_enhanced_grid_search         = true
    battenberg_use_beagle                   = true // false = IMPUTE2 phasing (hg19 bundle only)
    battenberg_beagle_max_mem               = 15 // GB; keep below task memory
    battenberg_beagle_window                = 40
    battenberg_beagle_overlap               = 4

    // Somatic SNV VAF evaluation
    vaf_min_depth                 = 20 // tumour ref + alt reads
    vaf_min_alt_reads             = 3
    vaf_pass_only                 = true
    vaf_autosomes_only            = true
    vaf_max_total_cn              = 8 // skip clonal segments above this total CN
    vaf_min_snvs                  = 100 // clonal-segment SNVs needed for a QC verdict
    vaf_min_snvs_per_state        = 50 // SNVs needed per CN state peak
    vaf_ccf_tolerance             = 0.1 // |clonal CCF peak - 1| allowed for PASS
    vaf_max_exceed_fraction       = 0.05 // fraction above max expected VAF allowed for PASS

    // Downsampled sWGS (swgs-absolutecn v2.0.0 stage 2); [key] is the swgs-absolutecn config.yaml name
    swgs_bin                      = 30 // [bins] kb: 1,5,15,30,50,100,500,1000
    swgs_project                  = 'gel_cn'
    swgs_use_seed                 = true
    swgs_seed                     = 9999
    swgs_paired_end               = true
    swgs_auto_smooth              = false
    swgs_smooth_threshold         = 300
    swgs_smooth                   = false
    swgs_publish_bams             = false
    swgs_scripts_dir              = '/app/workflow/scripts' // path inside the container

    // ASCAT at SNP6 loci
    ascat_gamma                   = 1
    ascat_penalty                 = 70
    ascat_min_counts              = 10 // minimum normal depth
    ascat_min_base_qual           = 20
    ascat_min_map_qual            = 35
    ascat_seed                    = 42
    ascat_run_unconstrained       = true // also report ASCAT's own fit
    ascat_publish_allele_counts   = false

    // Containers
    container_battenberg          = 'phil9s/battenberg:3.0.0'
    // pinned by digest: the repository only has a mutable 'latest' tag (pushed 2023-08-09)
    container_ascat               = 'phil9s/ascat_v3_1_2@sha256:1d97ba239165650052b549418b503a1080e37c8b0df04cb732a2142266db5b3f'
    container_allelecounter       = 'phil9s/ascat_v3_1_2@sha256:1d97ba239165650052b549418b503a1080e37c8b0df04cb732a2142266db5b3f'
    container_swgs                = 'phil9s/swgs-absolutecn:v2.0.0'
    container_strelka             = 'quay.io/biocontainers/strelka:2.9.10--h9ee0642_1'
    container_r                   = 'rocker/tidyverse:4.3.2'

    // Per-task resource caps
    max_cpus                      = 32
    max_memory                    = '256.GB'
    max_time                      = '168.h'

    // Scheduler submission
    queue                         = null
    long_queue                    = null // for tasks over long_queue_min_hours
    long_queue_min_hours          = 4
    cluster_account               = null
    cluster_options               = null
    slurm_qos                     = null
    queue_size                    = 100
    submit_rate_limit             = '50/1min'
    lsf_per_job_mem_limit         = false // true if LSB_JOB_MEMLIMIT=Y
    lsf_per_task_reserve          = false // true if RESOURCE_RESERVE_PER_TASK=Y

    // Container runtime
    singularity_cache_dir         = null
    container_bind                = null // comma-separated extra binds
}

includeConfig 'conf/genomes.config'
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    local {
        process.executor        = 'local'
    }
    slurm {
        process {
            executor            = 'slurm'
            queue               = { params.long_queue && task.time && task.time.toHours() > params.long_queue_min_hours ? params.long_queue : params.queue }
            clusterOptions      = { [ params.cluster_account ? "--account=${params.cluster_account}" : '',
                                      params.slurm_qos ? "--qos=${params.slurm_qos}" : '',
                                      params.cluster_options ?: '' ].findAll { opt -> opt }.join(' ') }
        }
        executor {
            queueSize           = params.queue_size
            submitRateLimit     = params.submit_rate_limit
            pollInterval        = '30 sec'
            queueStatInterval   = '2 min'
        }
    }
    lsf {
        process {
            executor            = 'lsf'
            queue               = { params.long_queue && task.time && task.time.toHours() > params.long_queue_min_hours ? params.long_queue : params.queue }
            clusterOptions      = { [ params.cluster_account ? "-P ${params.cluster_account}" : '',
                                      params.cluster_options ?: '' ].findAll { opt -> opt }.join(' ') }
        }
        executor {
            queueSize           = params.queue_size
            submitRateLimit     = params.submit_rate_limit
            perJobMemLimit      = params.lsf_per_job_mem_limit
            perTaskReserve      = params.lsf_per_task_reserve
            pollInterval        = '30 sec'
            queueStatInterval   = '2 min'
        }
    }
    pbs {
        process {
            executor            = 'pbs'
            queue               = { params.long_queue && task.time && task.time.toHours() > params.long_queue_min_hours ? params.long_queue : params.queue }
            clusterOptions      = { [ params.cluster_account ? "-A ${params.cluster_account}" : '',
                                      params.cluster_options ?: '' ].findAll { opt -> opt }.join(' ') }
        }
        executor {
            queueSize           = params.queue_size
            submitRateLimit     = params.submit_rate_limit
            pollInterval        = '30 sec'
            queueStatInterval   = '2 min'
        }
    }
    pbspro {
        process {
            executor            = 'pbspro'
            queue               = { params.long_queue && task.time && task.time.toHours() > params.long_queue_min_hours ? params.long_queue : params.queue }
            clusterOptions      = { [ params.cluster_account ? "-A ${params.cluster_account}" : '',
                                      params.cluster_options ?: '' ].findAll { opt -> opt }.join(' ') }
        }
        executor {
            queueSize           = params.queue_size
            submitRateLimit     = params.submit_rate_limit
            pollInterval        = '30 sec'
            queueStatInterval   = '2 min'
        }
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        singularity.cacheDir    = params.singularity_cache_dir
        singularity.runOptions  = params.container_bind ? params.container_bind.tokenize(',').collect { p -> "-B ${p.trim()}" }.join(' ') : ''
        apptainer.enabled       = false
        docker.enabled          = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        apptainer.cacheDir      = params.singularity_cache_dir
        apptainer.runOptions    = params.container_bind ? params.container_bind.tokenize(',').collect { p -> "-B ${p.trim()}" }.join(' ') : ''
        singularity.enabled     = false
        docker.enabled          = false
    }
    docker {
        docker.enabled          = true
        docker.runOptions       = '-u $(id -u):$(id -g)'
        singularity.enabled     = false
        apptainer.enabled       = false
    }
    gel {
        includeConfig 'conf/gel.config'
    }
}

// Keep containers isolated from the user's R/Python libraries
env {
    R_PROFILE_USER  = '/.Rprofile'
    R_ENVIRON_USER  = '/.Renviron'
    PYTHONNOUSERSITE = '1'
}

process.shell = ['/bin/bash', '-euo', 'pipefail']

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.html"
}
