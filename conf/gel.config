// Example profile for the Genomics England Research Environment (LSF), used with -profile gel.
// Queue names and limits are unverified; check them against current HPC docs.
// No internet access: pre-pull containers into singularity_cache_dir first.

params {
    outdir                  = '/re_scratch/re_gecip/cancer_pan/psmith2/cn_pipeline'
    cluster_account         = 're_gecip_cancer_pan'
    singularity_cache_dir   = '/re_scratch/re_gecip/cancer_pan/psmith2/singularity_cache'
    container_bind          = '/genomes,/re_scratch'
    max_cpus                = 24
    max_memory              = '180.GB'
    max_time                = '168.h'
}

process {
    // Set explicitly: base.config evaluates resourceLimits before this profile applies
    resourceLimits  = [ cpus: 24, memory: 180.GB, time: 168.h ]
    executor        = 'lsf'
    queue           = { task.time.toHours() <= 4 ? 'short' : (task.time.toHours() <= 24 ? 'medium' : 'long') }
    clusterOptions  = { "-P ${params.cluster_account}" }
}

executor {
    queueSize           = params.queue_size
    submitRateLimit     = params.submit_rate_limit
    // Read from lsf.conf when LSF_ENVDIR is set; otherwise pass --lsf_per_job_mem_limit true
    perJobMemLimit      = params.lsf_per_job_mem_limit
    pollInterval        = '30 sec'
    queueStatInterval   = '2 min'
}

singularity {
    enabled     = true
    autoMounts  = true
    cacheDir    = params.singularity_cache_dir
    runOptions  = params.container_bind.tokenize(',').collect { p -> "-B ${p.trim()}" }.join(' ')
}
