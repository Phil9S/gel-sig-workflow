// Output publishing under params.outdir

process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode
    ]

    withName: 'BATTENBERG' {
        publishDir = [
            path: { "${params.outdir}/battenberg/${meta.cancer}/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'BATTENBERG_PURITY_PLOIDY' {
        publishDir = [
            path: { "${params.outdir}/purity_ploidy/${meta.cancer}" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'STRELKA_SOMATIC' {
        publishDir = [
            path: { "${params.outdir}/snvs/strelka/${meta.cancer}/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'VAF_EVALUATION' {
        publishDir = [
            path: { "${params.outdir}/vaf_evaluation/${meta.cancer}/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }
    // Matches the swgs-absolutecn v2.0.0 output layout
    withName: 'SWGS_DOWNSAMPLE_QDNASEQ' {
        publishDir = [
            path: { "${params.outdir}/sWGS_fitting/${params.swgs_project}_${params.swgs_bin}kb/absolute_POST_down_sampling" },
            mode: params.publish_dir_mode,
            saveAs: { fn ->
                fn.endsWith('_fitted_QC.tsv')      ? "${meta.id}/${fn}" :
                fn.endsWith('_relSmoothedCN.rds')  ? "${meta.id}/relative_cn_rds/${fn}" :
                params.swgs_publish_bams           ? "downsampled_bams/${fn}" : null
            }
        ]
    }
    withName: 'SWGS_REL_TO_ABS' {
        publishDir = [
            path: { "${params.outdir}/sWGS_fitting/${params.swgs_project}_${params.swgs_bin}kb/absolute_POST_down_sampling/${meta.id}/abs_cn_rds" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'SWGS_COMBINE' {
        publishDir = [
            path: { "${params.outdir}/sWGS_fitting/${params.swgs_project}_${params.swgs_bin}kb/absolute_POST_down_sampling" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'ASCAT_SNP6_REFERENCE' {
        publishDir = [
            path: { "${params.outdir}/ascat_snp6/reference" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'ALLELECOUNTER_SNP6' {
        publishDir = [
            path: { "${params.outdir}/ascat_snp6/allele_counts/${acmeta.name}" },
            mode: params.publish_dir_mode,
            enabled: params.ascat_publish_allele_counts
        ]
    }
    withName: 'ASCAT_SNP6_RUN' {
        publishDir = [
            path: { "${params.outdir}/ascat_snp6/${meta.cancer}/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'CN_SUMMARY' {
        publishDir = [
            path: { "${params.outdir}/summary" },
            mode: params.publish_dir_mode
        ]
    }
}
