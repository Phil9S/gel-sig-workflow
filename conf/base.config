// Default compute resources. Tasks killed for exceeding resources are retried twice with
// more memory/time; a sample that still fails is dropped if --ignore_failed_samples is set,
// otherwise the run stops. Requests are capped by params.max_cpus/max_memory/max_time.

process {
    cpus            = 1
    memory          = { 4.GB * task.attempt }
    time            = { 4.h * task.attempt }

    errorStrategy   = { task.exitStatus in ((130..145) + 104 + 175) && task.attempt <= 2 ? 'retry' : (params.ignore_failed_samples ? 'ignore' : 'finish') }
    maxRetries      = 2
    maxErrors       = '-1'

    resourceLimits  = [
        cpus:   params.max_cpus,
        memory: params.max_memory,
        time:   params.max_time
    ]

    withLabel: 'process_single' {
        cpus    = 1
        memory  = { 4.GB * task.attempt }
        time    = { 2.h * task.attempt }
    }
    withLabel: 'process_low' {
        cpus    = 2
        memory  = { 8.GB * task.attempt }
        time    = { 4.h * task.attempt }
    }
    withLabel: 'process_medium' {
        cpus    = 8
        memory  = { 16.GB * task.attempt }
        time    = { 12.h * task.attempt }
    }
    withLabel: 'process_high' {
        cpus    = 16
        memory  = { 64.GB * task.attempt }
        time    = { 24.h * task.attempt }
    }

    // Per-process tuning
    withName: 'BATTENBERG' {
        cpus    = 16
        memory  = { 64.GB * task.attempt }
        time    = { 48.h * task.attempt }
    }
    withName: 'STRELKA_SOMATIC' {
        cpus    = 16
        memory  = { 32.GB * task.attempt }
        time    = { 24.h * task.attempt }
    }
    withName: 'VAF_EVALUATION' {
        cpus    = 1
        memory  = { 8.GB * task.attempt }
        time    = { 2.h * task.attempt }
    }
    // downsampleBams.R is single-threaded and reads the full BAM twice
    withName: 'SWGS_DOWNSAMPLE_QDNASEQ' {
        cpus    = 1
        memory  = { 16.GB * task.attempt }
        time    = { 24.h * task.attempt }
    }
    withName: 'SWGS_REL_TO_ABS' {
        cpus    = 1
        memory  = { 8.GB * task.attempt }
        time    = { 2.h * task.attempt }
    }
    withName: 'SWGS_COMBINE' {
        cpus    = 1
        memory  = { 32.GB * task.attempt }
        time    = { 4.h * task.attempt }
    }
    withName: 'ASCAT_SNP6_REFERENCE' {
        cpus    = 1
        memory  = { 8.GB * task.attempt }
        time    = { 4.h * task.attempt }
    }
    withName: 'ALLELECOUNTER_SNP6' {
        cpus    = 8
        memory  = { 8.GB * task.attempt }
        time    = { 12.h * task.attempt }
    }
    withName: 'ASCAT_SNP6_RUN' {
        cpus    = 1
        memory  = { 16.GB * task.attempt }
        time    = { 4.h * task.attempt }
    }

    // Cohort-level steps stop the run on failure
    withName: 'ASCAT_SNP6_REFERENCE|SWGS_COMBINE|CN_SUMMARY' {
        errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) && task.attempt <= 2 ? 'retry' : 'finish' }
    }
}
