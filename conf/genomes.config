// Reference data per genome build, selected by the samples.tsv 'build' column; override with -c.
// Battenberg paths are relative to battenberg_ref_dir unless absolute. ASCAT paths are relative
// to ascat_g1000_dir, or use the container's /ref/<build>/ when it is null.

params {
    genomes {
        hg19 {
            chr_prefix                          = false     // BAM contigs named 'chr1'

            // Strelka2 reference
            fasta                               = null
            fasta_fai                           = null      // defaults to "<fasta>.fai"
            strelka_call_regions                = null      // optional bgzipped BED (+ .tbi)

            // Battenberg bundle: https://ora.ox.ac.uk/objects/uuid:2c1fec09-a504-49ab-9ce9-3f17bac531bc
            battenberg_ref_dir                  = null
            battenberg_impute_info              = 'impute_info.txt'
            battenberg_g1000_loci_prefix        = 'battenberg_1000genomesloci2012_v3/1000genomesloci2012_chr'
            battenberg_g1000_alleles_prefix     = 'battenberg_1000genomesloci2012_v3/1000genomesAlleles2012_chr'
            battenberg_gc_prefix                = 'battenberg_wgs_gc_correction_1000g_v3/1000_genomes_GC_corr_chr_'
            battenberg_rt_prefix                = 'battenberg_wgs_replic_correction_1000g_v3/1000_genomes_replication_timing_chr_'
            battenberg_problem_loci             = 'probloci_270415.txt.gz'
            battenberg_chrom_coord_file         = 'gcCorrect_chromosome_coordinates_hg19.txt'
            battenberg_beagle_jar               = 'beagle/beagle.22Jul22.46e.jar'
            battenberg_beagle_ref_template      = 'beagle/b37/chrCHROMNAME.1kg.phase3.v5a.b37.bref3'
            battenberg_beagle_plink_template    = 'beagle/b37/plink.chrCHROMNAME.GRCh37.map'

            // ASCAT G1000: https://github.com/VanLoo-lab/ascat/tree/master/ReferenceFiles/WGS
            ascat_g1000_dir                     = null
            ascat_g1000_loci_prefix             = 'G1000_loci_hg19_chr'
            ascat_g1000_alleles_prefix          = 'G1000_alleles_hg19_chr'
            ascat_gc_file                       = 'GC_G1000_hg19.txt'
            ascat_rt_file                       = 'RT_G1000_hg19.txt'

            // SNP6 positions (TSV with chromosome/position), e.g. https://zenodo.org/records/14008443
            snp6_positions                      = null
        }
        hg38 {
            chr_prefix                          = true

            fasta                               = null
            fasta_fai                           = null
            strelka_call_regions                = null

            // Battenberg GRCh38 bundle: https://doi.org/10.48420/30406441
            battenberg_ref_dir                  = null
            battenberg_impute_info              = 'imputation/impute_info.txt'
            // no 'chr' prefix: '1000G_loci_hg38/1kg.phase3.v5a_GRCh38nounref_loci_chr'
            battenberg_g1000_loci_prefix        = '1000G_loci_hg38/1kg.phase3.v5a_GRCh38nounref_loci_chrstring_chr'
            battenberg_g1000_alleles_prefix     = '1000G_loci_hg38/1kg.phase3.v5a_GRCh38nounref_allele_index_chr'
            battenberg_gc_prefix                = 'GC_correction_hg38/1000G_GC_chr'
            battenberg_rt_prefix                = 'RT_correction_hg38/1000G_RT_chr'
            battenberg_problem_loci             = 'probloci/probloci.hg38_22072022.txt.gz'
            // no 'chr' prefix: 'chromosome_coordinates_hg38.txt'
            battenberg_chrom_coord_file         = 'chromosome_coordinates_hg38_chr.txt'
            battenberg_beagle_jar               = 'beagle5/beagle.22Jul22.46e.jar'
            battenberg_beagle_ref_template      = 'beagle5/chrCHROMNAME.1kg.phase3.v5a_GRCh38nounref.vcf.gz'
            battenberg_beagle_plink_template    = 'beagle5/plink.chrCHROMNAME.GRCh38.map'

            ascat_g1000_dir                     = null
            ascat_g1000_loci_prefix             = 'G1000_loci_hg38_chr'
            ascat_g1000_alleles_prefix          = 'G1000_alleles_hg38_chr'
            ascat_gc_file                       = 'GC_G1000_hg38.txt'
            ascat_rt_file                       = 'RT_G1000_hg38.txt'

            // SNP6 positions lifted over to GRCh38
            snp6_positions                      = null
        }
    }
}
